DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LOG_LEVEL=INFO

# Optional: switch settings module
# DJANGO_SETTINGS_MODULE=kms.settings.prod

# React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Calendar/Meet (optional)
# IMPORTANT: Do not commit real secrets. Keep them in local `.env` only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Default: http://127.0.0.1:8000/api/v1/google/oauth/callback/
GOOGLE_OAUTH_REDIRECT_URI=
# Default: https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_SCOPES=
# Default: primary
GOOGLE_CALENDAR_ID=
# Optional: after OAuth success, redirect to frontend URL (e.g. http://localhost:5173/portal/live-class)
GOOGLE_OAUTH_SUCCESS_REDIRECT=
