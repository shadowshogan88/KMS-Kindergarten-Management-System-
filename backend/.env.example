DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LOG_LEVEL=INFO

# Optional: switch settings module
# DJANGO_SETTINGS_MODULE=kms.settings.prod

# React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (SMTP)
# For Gmail: enable 2FA and create an App Password, then use it as SMTP_PASSWORD.
SCHOOL_NAME=KMS
FRONTEND_URL=http://localhost:5173
FRONTEND_PORTAL_LOGIN_PATH=/portal

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=KMS <yourgmail@gmail.com>
# Optional: keep console backend for local debugging (default auto-switches based on SMTP_HOST)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_FAIL_SILENTLY=0

# Google Calendar/Meet (optional)
# IMPORTANT: Do not commit real secrets. Keep them in local `.env` only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Default: http://127.0.0.1:8000/api/v1/google/oauth/callback/
GOOGLE_OAUTH_REDIRECT_URI=
# Default: https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_SCOPES=
# Default: primary
GOOGLE_CALENDAR_ID=
# Optional: after OAuth success, redirect to frontend URL (e.g. http://localhost:5173/portal/live-class)
GOOGLE_OAUTH_SUCCESS_REDIRECT=
